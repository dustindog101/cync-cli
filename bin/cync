#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
app_support=${CYNC_HOME:-"${HOME:?HOME is not set}/Library/Application Support/cync-cli"}
python="$app_support/venv/bin/python"

if [ -x "$python" ]; then
  exec "$python" -m cync_cli "$@"
fi

PYTHONPATH="$script_dir/../src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m cync_cli "$@"
